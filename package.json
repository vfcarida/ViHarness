{
  "name": "vi-harness",
  "version": "0.1.0",
  "description": "The world's best coding agent harness - synthesizing patterns from Claude Code, Aider, Prime Agent, Hermes, Pi, and Meta-Harness",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vi-harness": "./dist/cli/index.js",
    "vih": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime/index.js",
      "types": "./dist/runtime/index.d.ts"
    },
    "./tools": {
      "import": "./dist/infra/tools/index.js",
      "types": "./dist/infra/tools/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/infra/mcp/index.js",
      "types": "./dist/infra/mcp/index.d.ts"
    },
    "./storage": {
      "import": "./dist/infra/storage/index.js",
      "types": "./dist/infra/storage/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "harness",
    "mcp",
    "llm",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vfcarida/Vi-Harness"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/post-build.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:int": "vitest run tests/integration",
    "test:live": "vitest run tests/live",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage tests/unit",
    "test:cov": "vitest run --coverage tests/unit",
    "lint": "eslint src/ tests/",
    "benchmark": "tsx src/cli/benchmark-cli.ts",
    "benchmark:context": "tsx src/cli/context-benchmark-cli.ts",
    "bench:tbench": "tsx src/cli/tbench-eval.ts",
    "bench:projdevbench": "tsx src/cli/projdevbench-eval.ts",
    "bench:report": "tsx src/cli/benchmark-cli.ts --report-only",
    "docs": "tsx scripts/generate-api-docs.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "release": "tsx scripts/release.ts",
    "prepublish-check": "tsx scripts/prepublish-check.ts",
    "prepublishOnly": "npm run prepublish-check",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "uuid": "^14.0.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
